# =================================================================
# SIH26099: CPSE Material Standardization Backend Environment Config
# =================================================================

# Local development defaults. Set production values in Render's environment.
PORT=8080

# PostgreSQL. Render DATABASE_URL must use JDBC form:
# jdbc:postgresql://HOST:5432/DATABASE
DATABASE_URL=jdbc:postgresql://localhost:5432/sih_material_db
DB_USERNAME=postgres
DB_PASSWORD=

# Required; use a unique random value of at least 32 bytes in production.
JWT_SECRET=
JWT_EXPIRATION=86400000

# Required when SPRING_PROFILES_ACTIVE=prod. Use different random passwords.
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_USER_PASSWORD=

# Render: set SPRING_PROFILES_ACTIVE=prod and these three values.
SPRING_PROFILES_ACTIVE=

# Frontend origin (Render: your exact Vercel deployment URL)
FRONTEND_URL=http://localhost:5173

# Optional comma-separated override for local origins / preview deployments.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Python FastAPI ML Service Endpoint
ML_SERVICE_URL=http://localhost:8000
