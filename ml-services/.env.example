# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Hardware Acceleration
# Options: cpu, cuda
DEVICE=cpu

# Model Specifications
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
NER_MODEL_NAME=en_core_web_sm
CLASSIFICATION_MODEL_PATH=models/classification/taxonomy_classifier.joblib
MODEL_CACHE_DIR=models/cache

# Model Versions
MODEL_VERSION_EMBEDDING=embedding-v1
MODEL_VERSION_NER=ner-v1
MODEL_VERSION_CLASSIFIER=classifier-v1
PIPELINE_VERSION=harmonization-v1

# Hybrid Matching Weights (Must sum to 1.0)
SEMANTIC_WEIGHT=0.40
LEXICAL_WEIGHT=0.25
ATTRIBUTE_WEIGHT=0.35

# Classification Thresholds
EXACT_MATCH_THRESHOLD=0.90
EQUIVALENT_MATCH_THRESHOLD=0.75
SIMILAR_MATCH_THRESHOLD=0.50
DUPLICATE_THRESHOLD=0.85

# Security (Internal Spring Boot service authentication)
INTERNAL_API_KEY=
